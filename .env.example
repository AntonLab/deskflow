# Copy to .env and adjust if needed. .env is not committed.
DATABASE_URL=postgres://deskflow:deskflow@localhost:5432/deskflow
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://deskflow:deskflow@localhost:5672
IMPORTER_PORT=4010
API_PORT=4000
LOG_LEVEL=info

# Importer: one bearer token per tenant is required (IMPORTER_TOKENS=tenant:token,...); listens on loopback unless IMPORTER_HOST is set.
IMPORTER_TOKENS=acme:change-me
IMPORTER_HOST=127.0.0.1
